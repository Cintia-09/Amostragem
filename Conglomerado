N

###Filtrar estratos
summary(as.factor(dados$Estrato))
dados1= dados[dados$Estrato==1,];dados1
dados2= dados[dados$Estrato==2,];dados2
dados3= dados[dados$Estrato==3,];dados3
dados4= dados[dados$Estrato==4,];dados4


# Realizar a amostragem conglomerado

##AASc
set.seed(1612) # Definir a semente 
sam <- S.WR(4, 2);sam

####EStimação
E.WR(4, 2,c(sum(dados1$yk),sum(dados2$yk)))




###AASs
set.seed(1612) # Definir a semente 
sam <- S.SI(4, 2);sam


####EStimação
E.SI(4, 2,c(sum(dados3$yk),sum(dados4$yk)))


#####Bernoulli
set.seed(1612) # Definir a semente 
sam <-S.BE(4,0.3);sam

####EStimação
E.BE((sum(dados3$yk)),0.3)



####Poisson
set.seed(1612) # Definir a semente 
pk = c(0.25,0.30,0.25,0.40);pk
sam <-S.PO(4,pk);sam


##Estimaçao
E.PO(c(sum(dados2$yk),sum(dados3$yk)),pk)

####PPT

set.seed(1612) # Definir a semente 
