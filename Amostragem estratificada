# Ajuste para garantir que o total de amostras não exceda 30
ajuste <- function(alocacao) {
  total_arredondado <- sum(alocacao)
  if (total_arredondado > n_total) {
    diferenca <- total_arredondado - n_total
    # Ordena os estratos pelo valor arredondado e ajusta a maior quantidade
    ajustado <- alocacao - sort(alocacao, decreasing = TRUE)[1:diferenca]
  } else {
    ajustado <- alocacao
  }
  return(ajustado)
}

# Ajustar os valores arredondados
Na$uniforme <- ajuste(Na$uniforme);Na$uniforme
Na$proporcional <- ajuste(Na$proporcional);Na$proporcional
Na$proporcional_x <- ajuste(Na$proporcional_x);Na$proporcional_x
Na$neyman <- ajuste(Na$neyman);Na$neyma

